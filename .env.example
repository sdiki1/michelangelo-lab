TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MINIAPP_URL=https://example.com/miniapp
TELEGRAM_MINIAPP_URL=https://example.com/telegram-miniapp
MAX_MINIAPP_URL=https://example.com/max-miniapp
DATABASE_URL=postgresql+asyncpg://michelangelo:michelangelo@postgres:5432/michelangelo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Публичный HTTPS-адрес админки — используется кнопкой «Ответить клиенту».
ADMIN_BASE_URL=
# Через запятую. Администратор должен предварительно запустить соответствующего бота.
ORDER_NOTIFICATION_TELEGRAM_CHAT_IDS=
ORDER_NOTIFICATION_MAX_USER_IDS=
ORDER_NOTIFICATION_MAX_CHAT_IDS=
UPLOADS_DIR=/app/uploads
READYSCRIPT_WEBHOOK_SECRET=change-this-secret
# Секрет подписи вебхуков модуля michelangelo. Должен совпадать со значением
# в настройках модуля на стороне ReadyScript (Модули → Michelangelo).
RS_MODULE_SECRET=
RS_SIGNATURE_TOLERANCE_SECONDS=300
READYSCRIPT_SCRIPT_PATH=readyscript-orders/script.py
RS_API_BASE=https://example.com/api-key/methods/
RS_CLIENT_ID=
RS_CLIENT_SECRET=
RS_USERNAME=
RS_PASSWORD=
RS_PAGE_SIZE=100
RS_FETCH_ORDER_DETAILS=true
RS_FETCH_USERS=true
RS_REQUEST_DELAY_SECONDS=0.05
RS_REQUEST_TIMEOUT=30
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_POLL_TIMEOUT_SECONDS=30

# Самопроверка уведомлений. Массовый сбой: минимум 3 сообщения старше 3 часов.
# Единичный зависший случай: сигнал через сутки. Повтор сигнала: раз в 6 часов.
NOTIFICATION_ALERT_AFTER_MINUTES=180
NOTIFICATION_ALERT_MIN_FAILURES=3
NOTIFICATION_ALERT_ISOLATED_AFTER_MINUTES=1440
NOTIFICATION_ALERT_REMINDER_MINUTES=360

# Личные чаты администраторов Telegram
ORDER_NOTIFICATION_TELEGRAM_CHAT_IDS=
# Личные получатели MAX
ORDER_NOTIFICATION_MAX_USER_IDS=
# Необязательно: административные группы MAX
ORDER_NOTIFICATION_MAX_CHAT_IDS=
